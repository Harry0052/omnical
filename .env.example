# Copy to .env.local. These are empty placeholders. Do not put real secrets here.
#
# Next.js loads .env.local automatically. OAuth redirect URIs are:
#   ${NEXT_PUBLIC_APP_URL}/api/integrations/google/callback
#   ${NEXT_PUBLIC_APP_URL}/api/integrations/slack/callback

# Required for live Claude classification and artifact generation.
ANTHROPIC_API_KEY=

# Public app origin. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth client. One consent flow covers Calendar, Gmail, Docs, and Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth client.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
